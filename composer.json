  "autoload": {
    "psr-4": {
      "TomasChochola\\Quickmux\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "./tests"
    }
  },
  "config": {
    "allow-plugins": false,
    "audit": {
      "abandoned": "fail"
    },
    "platform-check": true,
    "process-timeout": 0,
    "sort-packages": true
  },
  "description": "tomaschochola/php-quickmux",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/tomaschochola"
    }
  ],
  "homepage": "https://github.com/tomaschochola/php-quickmux",
  "keywords": [
    "tomaschochola",
    "TomasChochola",
    "Tomas Chochola",
    "Tomáš Chochola",
    "php-quickmux"
  ],
  "license": "CC-BY-ND-4.0",
  "minimum-stability": "dev",
  "name": "tomaschochola/php-quickmux",
  "prefer-stable": true,
  "readme": "./README.md",
  "repositories": [
    {
      "no-api": true,
