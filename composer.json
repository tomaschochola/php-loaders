      "type": "git",
      "url": "https://github.com/tomaschochola/php-psr-17-http-factory.git"
    },
    {
      "no-api": true,
      "type": "git",
      "url": "https://github.com/tomaschochola/php-psr-16-simple-cache.git"
    },
    {
      "no-api": true,
      "type": "git",
      "url": "https://github.com/tomaschochola/php-psr-15-request-handlers.git"
    },
    {
      "no-api": true,
      "type": "git",
      "url": "https://github.com/tomaschochola/php-psr-11-container.git"
